<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.0" snapToGrid="true">
  <code><![CDATA[; ============================
; SIMULACIÓN COLECTIVOS + GIS + APOYOS + HEADWAY + MONTE CARLO
; NetLogo 7.0
; ============================

extensions [ gis table csv ]

globals [
  ; --- cronograma desde CSV ---
  g-departures
  sim-start-hms
  sim-start-seconds

  ; --- ruta elegida ---
  target-ramal
  selected-rid
  km-per-world-unit
  route-km-assumed
  epsilon

  ; --- GIS / routebook ---
  ds
  g-routebook-vertices
  g-routebook-meta
  g-spawned

  ; --- tiempo ---
  seconds-per-tick
  base-trip-seconds

  ; SE ELIMINAN WIDGETS, SE AGREGAN COMO GLOBALES
  bus-speed-default          ; se calibra automático a base-trip-seconds
  mech-speed-factor          ; 2.0 = el auxilio va al doble de velocidad
  breakdown-probability      ; probabilidad por tick

  ; --- apoyos (depots) ---
  support-km-list            ; kms desde inicio (0..route-km-assumed)
  support-policy             ; "nearest" | "behind" | "ahead" ;; tres oopciones en el informe solo se uso nearest, mas realista
  support-km-effective       ; (derivado) lista efectiva usada internamente
  support-idx-list           ; índices de vértice (alineados con support-km-effective)

  ; --- headway ---
  checkpoint-km
  last-checkpoint-runsec
  last-arrival-runsec

  ; --- salida ---
  output-filename

  ; --- Monte Carlo ---
  mc-mode?
  run-id
  base-seed
]

breed [ buses bus ]
breed [ mechanics mechanic ]

buses-own [
  trip-id
  ext-bus-id

  distance-traveled-km
  my-path-vertices
  current-vertex-index
  broken-down?
  bus-speed
  start-tick

  passed-checkpoint?
  last-support-km           ; km del apoyo usado en el breakdown más reciente (o -1)
]

mechanics-own [
  target-bus
  my-path-vertices
  current-vertex-index
  mech-speed
  mech-step                ; +1 si va “hacia adelante” por la ruta, -1 si viene “en contra”
]

; ===================== HELPERS GEOM =====================

to-report vertices->xy [vs]
  report filter [c -> not empty? c] map [v -> gis:location-of v] vs
end

to-report p-dist [a b]
  let dx1 (item 0 a - item 0 b)
  let dy1 (item 1 a - item 1 b)
  report sqrt (dx1 * dx1 + dy1 * dy1)
end

to-report polyline-length [coords]
  if length coords < 2 [ report 0 ]
  let total 0
  let prev first coords
  foreach but-first coords [ c ->
    set total total + p-dist c prev
    set prev c
  ]
  report total
end

to-report clean-route [pts eps]
  if length pts < 2 [ report pts ]
  let out (list (first pts))
  foreach but-first pts [ p ->
    if p-dist p (last out) >= eps [
      set out lput p out
    ]
  ]
  report out
end

to draw-base
  ask patches [ set pcolor gray + 2 ]
  clear-drawing
  gis:set-drawing-color (gray + 1)
  gis:draw ds 0.3
end

; ===================== HELPERS TIEMPO =====================

to-report hms->seconds [hms]
  let h read-from-string substring hms 0 2
  let m read-from-string substring hms 3 5
  let s read-from-string substring hms 6 8
  report h * 3600 + m * 60 + s
end

to-report pad2 [n]
  if n < 10 [ report (word "0" n) ]
  report (word n)
end

to-report tick->hms [t]
  let total (sim-start-seconds + t * seconds-per-tick)
  let sec-day total mod 86400
  let hh floor (sec-day / 3600)
  let mm floor ((sec-day mod 3600) / 60)
  let ss floor (sec-day mod 60)
  report (word pad2 hh ":" pad2 mm ":" pad2 ss)
end

to-report tick->hour-decimal [t]
  let total (sim-start-seconds + t * seconds-per-tick)
  let sec-day total mod 86400
  report sec-day / 3600
end

to-report runsec
  report ticks * seconds-per-tick
end

; ===================== SETUP =====================

to setup
  clear-all
  reset-ticks

  ; ---- Monte Carlo flags ----
  set mc-mode? false
  set run-id 1
  set base-seed 12345

  ; ---- defaults base ----
  set base-trip-seconds 6780.96      ; 1:53 hs
  set seconds-per-tick 16.62
  set sim-start-hms "05:50:00"
  set sim-start-seconds hms->seconds sim-start-hms

  set epsilon 1e-5
  set route-km-assumed 38
  set target-ramal "C"

  ; ---- dinámica sin widgets obligatorios ----
  set mech-speed-factor 2.0
  set breakdown-probability 0.0014   ; ajustá
  set checkpoint-km 20

  ; ---- apoyos (probá listas distintas) ----
  set support-km-list [0 7 15 20 30]   ; kms desde inicio
  set support-policy "nearest"                  ; "nearest"|"behind"|"ahead"

  ; ---- estado headway ----
  set last-checkpoint-runsec -1
  set last-arrival-runsec -1

  ; ---- tablas ----
  set g-routebook-vertices table:make
  set g-routebook-meta table:make
  set g-spawned table:make
  set g-departures table:make

  ; ---- archivo “corrida normal” ----
  set output-filename "sim_linea51_supports_headway_run.csv"
  if file-exists? output-filename [ file-delete output-filename ]
  file-open output-filename
  file-print "timestamp,trip_id,bus_id,distance_km,event,aux_km,headway_sec"
  file-flush

  ; ---- GIS ----
  if file-exists? "data/Lineas_BUS_RMBA_Jurisdiccion_Nacional.shp" [
    set ds gis:load-dataset "data/Lineas_BUS_RMBA_Jurisdiccion_Nacional.shp"
    gis:set-world-envelope gis:envelope-of ds
    draw-base
    build-routebook
    select-one-route
    load-departures-from-csv "trips_linea51_ida.csv"
  ]
end

; ===================== ROUTEBOOK =====================

to build-routebook
  foreach (gis:feature-list-of ds) [ f ->
    let linea ""  let ramal ""  let sentido ""
    carefully [
      set linea   gis:property-value f "LINEA"
      set ramal   gis:property-value f "RAMAL"
      set sentido gis:property-value f "SENTIDO"
    ] []

    if (linea != "" and ramal != "" and sentido != "") [
      let parts gis:vertex-lists-of f
      let best-coords []
      let best-len -1

      foreach parts [ vs ->
        let coords vertices->xy vs
        set coords clean-route coords epsilon
        let L polyline-length coords
        if (L > best-len) and (length coords >= 2) [
          set best-len L
          set best-coords coords
        ]
      ]

      if length best-coords >= 2 [
        let rid (word linea "-" ramal "-" sentido)
        ifelse table:has-key? g-routebook-vertices rid [
          let prev table:get g-routebook-vertices rid
          ifelse polyline-length best-coords > polyline-length prev [
            table:put g-routebook-vertices rid best-coords
          ] []
        ] [
          table:put g-routebook-vertices rid best-coords
        ]
        table:put g-routebook-meta rid (list linea ramal sentido)
      ]
    ]
  ]
end

to select-one-route
  set selected-rid nobody

  foreach (table:keys g-routebook-meta) [ rid ->
    let meta table:get g-routebook-meta rid
    if is-list? meta [
      let linea item 0 meta
      let ramal item 1 meta
      let sentido item 2 meta
      if (linea = "51") and (ramal = target-ramal) and (sentido = "IDA") [
        set selected-rid rid
      ]
    ]
  ]

  if selected-rid = nobody [
    foreach (table:keys g-routebook-meta) [ rid ->
      if selected-rid = nobody [
        let meta table:get g-routebook-meta rid
        if is-list? meta [
          let linea item 0 meta
          let sentido item 2 meta
          if (linea = "51") and (sentido = "IDA") [
            set selected-rid rid
          ]
        ]
      ]
    ]
  ]

  if selected-rid != nobody [
    let path table:get g-routebook-vertices selected-rid
    let worldLen polyline-length path

    ifelse worldLen > 0 [
      set km-per-world-unit (route-km-assumed / worldLen)
    ] [
      set km-per-world-unit 0
    ]
    set bus-speed-default 0.1
    build-support-indexes path
    if not mc-mode? [ draw-selected-route path ]
  ]
end

to draw-selected-route [path]
  if length path < 2 [ stop ]
  create-turtles 1 [
    hide-turtle
    set color blue
    set pen-size 2
    let p0 item 0 path
    setxy (item 0 p0) (item 1 p0)
    pen-down
    foreach but-first path [ p ->
      setxy (item 0 p) (item 1 p)
    ]
    pen-up
    die
  ]
end

; ===================== APOYOS =====================

to build-support-indexes [path] ;contruye los vertices donde habrá apoyos
  set support-km-effective support-km-list
  set support-idx-list []
  let cumlist (list 0)
  let cum 0
  let prev first path
  foreach but-first path [p ->
    set cum cum + (p-dist prev p) * km-per-world-unit
    set cumlist lput cum cumlist
    set prev p
  ]

  ; para cada support km, buscar primer índice cuyo cum >= km
  foreach support-km-effective [skm ->
    let idx 0
    while [idx < length cumlist and (item idx cumlist) < skm] [
      set idx idx + 1
    ]
    if idx >= length cumlist [ set idx (length cumlist - 1) ]
    set support-idx-list lput idx support-idx-list
  ]
end

to-report choose-support [bd-km]
  let n length support-km-effective
  if n = 0 [ report (list 0 1 0) ]

  if support-policy = "behind" [
    let bestI -1
    let bestK -1e9
    let i 0
    while [i < n] [
      let k item i support-km-effective
      if (k <= bd-km) and (k > bestK) [
        set bestK k
        set bestI i
      ]
      set i i + 1
    ]
    if bestI = -1 [ set bestI 0 set bestK item 0 support-km-effective ]
    report (list (item bestI support-idx-list) 1 bestK)
  ]

  if support-policy = "ahead" [
    let bestI -1
    let bestK 1e9
    let i 0
    while [i < n] [
      let k item i support-km-effective
      if (k >= bd-km) and (k < bestK) [
        set bestK k
        set bestI i
      ]
      set i i + 1
    ]
    if bestI = -1 [ set bestI (n - 1) set bestK item bestI support-km-effective ]
    report (list (item bestI support-idx-list) -1 bestK)
  ]

  ; default: nearest
  let bestI 0
  let bestK item 0 support-km-effective
  let bestD abs (bd-km - bestK)

  let i 1
  while [i < n] [
    let k item i support-km-effective
    let d abs (bd-km - k)
    if d < bestD [
      set bestD d
      set bestK k
      set bestI i
    ]
    set i i + 1
  ]

  let step (ifelse-value (bestK <= bd-km) [1] [-1])
  report (list (item bestI support-idx-list) step bestK)
end

; ===================== CSV HORARIOS =====================

to load-departures-from-csv [csvfile]
  if not file-exists? csvfile [
    print (word "No existe " csvfile)
    stop
  ]

  let rows csv:from-file csvfile
  if length rows < 2 [ stop ]

  let hdr first rows
  let i_trip position "trip_id" hdr
  let i_bus  position "bus_id"  hdr
  let i_time position "start_time" hdr

  if (i_trip = false) or (i_bus = false) or (i_time = false) [
    print "CSV inválido: necesito columnas trip_id,bus_id,start_time"
    stop
  ]

  foreach but-first rows [ r ->
    let tid item i_trip r
    let bid item i_bus  r
    let hms item i_time r

    let depart-sec hms->seconds hms
    let offset-sec (depart-sec - sim-start-seconds)
    let dep-tick floor (offset-sec / seconds-per-tick)

    if dep-tick >= 0 [
      let lst table:get-or-default g-departures dep-tick []
      table:put g-departures dep-tick (lput (list tid bid) lst)
    ]
  ]

  print (word "Salidas cargadas: " length table:keys g-departures)
end

to dispatch-departures
  if table:has-key? g-departures ticks [
    let salidas table:get g-departures ticks
    foreach salidas [ pair ->
      spawn-one-bus (item 0 pair) (item 1 pair)
    ]
    table:remove g-departures ticks
  ]
end

; ===================== SPAWN =====================

to spawn-one-bus [tid bid]
  if selected-rid = nobody [ stop ]
  let path table:get g-routebook-vertices selected-rid
  if length path < 2 [ stop ]

  create-buses 1 [
    set trip-id tid
    set ext-bus-id bid
    set distance-traveled-km 0
    set my-path-vertices path
    set current-vertex-index 0
    set broken-down? false
    set bus-speed bus-speed-default
    set start-tick ticks

    set passed-checkpoint? false
    set last-support-km -1

    ifelse member? "bus" shapes [ set shape "bus" ] [ set shape "box" ]
    set size 2
    set color blue

    let p item 0 my-path-vertices
    setxy (item 0 p) (item 1 p)

    log-event "DEPARTURE" "" ""
  ]
end

; ===================== LOOP =====================

to go
  dispatch-departures

  if (not any? buses) and (not any? mechanics) and empty? (table:keys g-departures) [
    if not mc-mode? [ file-close ]
    stop
  ]

  ask buses [ bus-move ]
  ask mechanics [ mechanic-move ]

  tick
end

; ===================== BUS MOVE =====================

to bus-move
  if broken-down? [
    set color red
    stop
  ]
  set color blue

  let oldx xcor
  let oldy ycor

  if current-vertex-index >= (length my-path-vertices) - 1 [
    handle-end-of-path
    stop
  ]

  let target (item (current-vertex-index + 1) my-path-vertices)
  let qx item 0 target
  let qy item 1 target

  let d distancexy qx qy
  ifelse d > bus-speed [
    if d > 0 [ set heading towardsxy qx qy ]
    fd bus-speed
  ] [
    setxy qx qy
    set current-vertex-index (current-vertex-index + 1)
  ]

  let moved distancexy oldx oldy
  set distance-traveled-km distance-traveled-km + (moved * km-per-world-unit)

  ; ---- CHECKPOINT headway (tiempo real) ----
  if (not passed-checkpoint?) and (distance-traveled-km >= checkpoint-km) [
    set passed-checkpoint? true
    let hw ""
    if last-checkpoint-runsec >= 0 [
      set hw (runsec - last-checkpoint-runsec)
    ]
    set last-checkpoint-runsec runsec
    log-event "CHECKPOINT" "" hw
  ]

  ; ---- BREAKDOWN ----
  if (random-float 1 < breakdown-probability) [
    set broken-down? true
    set color red

    let bd-km distance-traveled-km
    let choice choose-support bd-km
    let sIdx item 0 choice
    let step item 1 choice
    let sKm  item 2 choice
    set last-support-km sKm

    request-assistance sIdx step
    log-event "BREAKDOWN" sKm ""
  ]
end

to handle-end-of-path
  let travel-sec runsec - (start-tick * seconds-per-tick)
  let delay-sec travel-sec - base-trip-seconds

  if not mc-mode? [
    print (word "Bus " who " delay(s): " precision delay-sec 2)
  ]

  ; headway en ARRIVAL
  let hw ""
  if last-arrival-runsec >= 0 [
    set hw (runsec - last-arrival-runsec)
  ]
  set last-arrival-runsec runsec

  log-event "ARRIVAL" "" hw
  die
end

; ===================== AUXILIO =====================

to request-assistance [support-idx step]
  let _path my-path-vertices
  let _target self

  ; punto de inicio del auxilio
  let start-pos item support-idx _path
  let sx item 0 start-pos
  let sy item 1 start-pos

  ; IMPORTANTE: no usamos create-mechanics (observer-only).
  ; Spawneamos desde un patch (patch context) con sprout-mechanics.
  ask patch sx sy [
    sprout-mechanics 1 [
      set shape "truck"
      set size 1.5
      set color yellow

      set target-bus _target
      set my-path-vertices _path
      set current-vertex-index support-idx
      set mech-step step
      set mech-speed (bus-speed-default * mech-speed-factor)

      ; ubicamos exacto (no al centro del patch)
      setxy sx sy
    ]
  ]
end

to mechanic-move
  if target-bus = nobody [ die ]
  if [broken-down?] of target-bus = false [ die ]

  if distance target-bus < 0.3 [
    repair-bus
    stop
  ]

  ; si viene “en contra”, va bajando índices
  let next-idx (current-vertex-index + mech-step)
  if (next-idx < 0) or (next-idx >= length my-path-vertices) [
    die
    stop
  ]

  let target (item next-idx my-path-vertices)
  let qx item 0 target
  let qy item 1 target

  let d distancexy qx qy
  ifelse d > mech-speed [
    if d > 0 [ set heading towardsxy qx qy ]
    fd mech-speed
  ] [
    setxy qx qy
    set current-vertex-index next-idx
  ]
end

to repair-bus
  ask target-bus [
    set broken-down? false
    set color blue
    log-event "REPAIRED" last-support-km ""
  ]
  die
end

; ===================== LOG CSV =====================

to log-event [event-type aux-km headway-sec]
  let ts tick->hms ticks

  ; normalizar campos opcionales
  let aux aux-km
  if is-number? aux-km [
    if aux-km < 0 [ set aux "" ]
  ]

  let hw headway-sec
  if is-number? headway-sec [
    if headway-sec < 0 [ set hw "" ]
    if headway-sec >= 0 [ set hw precision headway-sec 2 ]
  ]

  let dist precision distance-traveled-km 3

  ifelse mc-mode? [
    file-print csv:to-row (list run-id ts trip-id ext-bus-id dist event-type aux hw)
  ] [
    file-print csv:to-row (list ts trip-id ext-bus-id dist event-type aux hw)
    file-flush
  ]
end

; ===================== MONTE CARLO =====================

to reset-run-state
  clear-turtles
  reset-ticks

  set g-departures table:make

  set last-checkpoint-runsec -1
  set last-arrival-runsec -1

  load-departures-from-csv "trips_linea51_ida.csv"
end

to montecarlo [n]
  ; usar: setup  ->  montecarlo 200
  set mc-mode? true

  file-close-all
  set output-filename "sim_linea51_mc_supports_FiveBases.csv"
  if file-exists? output-filename [ file-delete output-filename ]
  file-open output-filename
  file-print "run_id,timestamp,trip_id,bus_id,distance_km,event,aux_km,headway_sec"

  no-display

  let k 0
  repeat n [
    set k k + 1
    set run-id k
    random-seed (base-seed + run-id)

    reset-run-state

    while [ (any? buses) or (any? mechanics) or (not empty? (table:keys g-departures)) ] [
      go
    ]

    file-flush
  ]

  file-close
  display
  set mc-mode? false
end
]]></code>
  <widgets>
    <view x="290" wrappingAllowedX="true" y="40" frameRate="30.0" minPycor="-16" height="1159" showTickCounter="true" patchSize="35.0" fontSize="10" wrappingAllowedY="true" width="1159" tickCounterLabel="ticks" maxPycor="16" updateMode="1" maxPxcor="16" minPxcor="-16"></view>
    <plot x="30" autoPlotX="true" yMax="40.0" autoPlotY="true" yAxis="Km Recorridos" y="355" xMin="5.0" height="250" legend="false" xMax="18.0" yMin="0.0" width="250" xAxis="Hora del Día" display="Marey: Distancia vs Tiempo">
      <setup></setup>
      <update></update>
    </plot>
    <button x="160" y="615" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="115">go</button>
    <button x="25" y="615" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="125" display="Setup">setup</button>
  </widgets>
