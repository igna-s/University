<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.0" snapToGrid="true">
  <code><![CDATA[; ============================
; SIMULACIÓN DE COLECTIVOS + GIS (NetLogo 7.0)
; ============================

extensions [ gis table ]

; ---------- CONFIG ----------
globals [
  ds
  epsilon                            ; tolerancia para filtrar vértices muy pegados
  g-routebook-vertices               ; rid -> [[x y] ...]
  g-routebook-meta                   ; rid -> [linea ramal sentido]
  g-routebook-ida-vuelta             ; rid-IDA -> rid-VUELTA (si se mapea)
  g-bus-log                          ; bus-id -> eventos
  filter-linea                       ; "51"
  allowed-ramales51                  ; ["A" ..."H"]
  g-spawned                          ; rid -> true (para evitar duplicados)
]

breed [ buses bus ]
buses-own [
  my-route-id
  my-linea
  my-ramal
  my-path-vertices
  current-vertex-index               ; índice del próximo vértice a alcanzar
  current-direction                  ; "IDA" | "VUELTA"
  broken-down?
  bus-speed
  start-tick
]

; ============== HELPERS GEOM ==============
to-report vertices->xy [vs]
  ;; vs: lista de vértices GIS (coordenadas del SHP). gis:location-of -> coords NetLogo
  report filter [c -> not empty? c] map [v -> gis:location-of v] vs
end

to-report p-dist [a b]
  let dx1 (item 0 a - item 0 b)
  let dy1 (item 1 a - item 1 b)
  report sqrt (dx1 * dx1 + dy1 * dy1)
end

to-report clean-route [pts eps]
  ;; elimina consecutivos con distancia < eps
  if length pts < 2 [ report pts ]
  let out (list (first pts))
  foreach but-first pts [ p ->
    if p-dist p (last out) >= eps [
      set out lput p out
    ]
  ]
  report out
end

to-report polyline-length [coords]
  if length coords < 2 [ report 0 ]
  let total 0
  let prev first coords
  foreach but-first coords [ c ->
    set total total + p-dist c prev
    set prev c
  ]
  report total
end

to draw-base
  ask patches [ set pcolor gray + 2 ]
  clear-drawing
  gis:set-drawing-color (gray + 1)
  gis:draw ds 0.3
end

; ============== SETUP ==============
to setup
  clear-all
  reset-ticks

  ;; defaults razonables (si no usás sliders)
  set epsilon 1e-5
  set filter-linea "51"
  set allowed-ramales51 ["A" "B" "C" "D" "E" "F" "G" "H"]

  set g-bus-log table:make
  set g-routebook-vertices table:make
  set g-routebook-meta table:make
  set g-routebook-ida-vuelta table:make
  set g-spawned table:make

  set ds gis:load-dataset "data/Lineas_BUS_RMBA_Jurisdiccion_Nacional.shp"
  gis:set-world-envelope gis:envelope-of ds
  draw-base

  build-routebook
  spawn-buses

  ;; plot base (si tenés un plot llamado "KPIs")
  set-current-plot "KPIs"
  clear-plot
  if not plot-pen-exists? "Buses" [
    create-temporary-plot-pen "Buses"
  ]
  if not plot-pen-exists? "Averiados" [
    create-temporary-plot-pen "Averiados"
  ]
end

; ============== ROUTEBOOK ==============
to build-routebook
  let ida-map table:make     ;; "LINEA-RAMAL" -> [rid-IDA ...]
  let vuelta-map table:make  ;; "LINEA-RAMAL" -> [rid-VUELTA ...]

  foreach (gis:feature-list-of ds) [ f ->
    let linea ""  let ramal ""  let sentido ""
    carefully [
      set linea   gis:property-value f "LINEA"
      set ramal   gis:property-value f "RAMAL"
      set sentido gis:property-value f "SENTIDO"
    ] [
      ;; si falta algo, lo salteamos
    ]

    if (linea != "" and ramal != "" and sentido != "") [
      ;; Elegimos UNA sola parte por feature: la más larga (evita mezclar tramos disjuntos)
      let parts gis:vertex-lists-of f
      let best-coords []
      let best-len -1
      foreach parts [ vs ->
        let coords vertices->xy vs
        set coords clean-route coords epsilon
        let L polyline-length coords
        if (L > best-len) and (length coords >= 2) [
          set best-len L
          set best-coords coords
        ]
      ]

      if length best-coords >= 2 [
        let rid (word linea "-" ramal "-" sentido)
        ;; si aparece dos veces el mismo rid, nos quedamos con el más largo
        ifelse table:has-key? g-routebook-vertices rid [
          let prev table:get g-routebook-vertices rid
          ifelse polyline-length best-coords > polyline-length prev [
            table:put g-routebook-vertices rid best-coords
          ] [
            ; No hacer nada, mantener el anterior
          ]
        ] [
          table:put g-routebook-vertices rid best-coords
        ]
        table:put g-routebook-meta rid (list linea ramal sentido)

        let lr (word linea "-" ramal)
        if sentido = "IDA" [
          if not table:has-key? ida-map lr [ table:put ida-map lr [] ]
          table:put ida-map lr lput rid (table:get ida-map lr)
        ]
        if sentido = "VUELTA" [
          if not table:has-key? vuelta-map lr [ table:put vuelta-map lr [] ]
          table:put vuelta-map lr lput rid (table:get vuelta-map lr)
        ]
      ]
    ]
  ]

  ;; Mapeo IDA -> VUELTA por proximidad (por si querés usarlo a futuro)
  foreach (table:keys ida-map) [ lr ->
    if table:has-key? vuelta-map lr [
      let ida-list    table:get ida-map lr
      let vuelta-list table:get vuelta-map lr
      let usados table:make
      foreach ida-list [ rid-ida ->
        let path-ida table:get g-routebook-vertices rid-ida
        let a0 first path-ida
        let a1 last  path-ida
        let best-rid nobody
        let best-cost 1.0e30
        foreach vuelta-list [ rid-v ->
          if not table:has-key? usados rid-v [
            let path-v table:get g-routebook-vertices rid-v
            let b0 first path-v
            let b1 last  path-v
            let cost min (list (p-dist a0 b0 + p-dist a1 b1)
                               (p-dist a0 b1 + p-dist a1 b0))
            if cost < best-cost [
              set best-cost cost
              set best-rid rid-v
            ]
          ]
        ]
        if best-rid != nobody [
          table:put g-routebook-ida-vuelta rid-ida best-rid
          table:put usados best-rid true
        ]
      ]
    ]
  ]
end

; ============== SPAWN BUSES ==============
to spawn-buses
  ;; Creamos buses SOLO para IDA de la línea 51 y ramales A..H
  foreach (table:keys g-routebook-vertices) [ rid ->
    let meta table:get g-routebook-meta rid
    if is-list? meta [
      let linea   item 0 meta
      let ramal   item 1 meta
      let sentido item 2 meta
      if (linea = filter-linea) and (sentido = "IDA") and member? ramal allowed-ramales51 [
        if not table:has-key? g-spawned rid [
          let path table:get g-routebook-vertices rid
          if length path >= 2 [
            create-buses 1 [
              set my-route-id rid
              set my-linea linea
              set my-ramal ramal
              set my-path-vertices path
              set current-direction "IDA"
              set current-vertex-index 0
              set broken-down? false
              set bus-speed bus-speed-default
              set start-tick ticks

              ifelse member? "bus" shapes [ set shape "bus" ] [ set shape "car" ]
              set size 1.5
              set color blue - 1

              let p item 0 my-path-vertices
              setxy (item 0 p) (item 1 p)
            ]
            table:put g-spawned rid true
            print (word "Created bus for route: " rid " on line " linea)
          ]
        ]
      ]
    ]
  ]
end

; ============== LOOP ==============
to go
  if not any? buses [ stop ]
  ask buses [ bus-move ]

  ;; KPIs del sistema
  set-current-plot "KPIs"
  ;; Asegurar que los pens existen antes de usarlos
  if not plot-pen-exists? "Buses" [
    create-temporary-plot-pen "Buses"
  ]
  if not plot-pen-exists? "Averiados" [
    create-temporary-plot-pen "Averiados"
  ]
  set-current-plot-pen "Buses"
  plot count buses
  set-current-plot-pen "Averiados"
  plot count buses with [ broken-down? ]

  tick
end

; ============== MOVIMIENTO ==============
to bus-move  ;; turtle
  if broken-down? [ set color red stop ]

  if current-vertex-index >= (length my-path-vertices) - 1 [
    handle-end-of-path
    stop
  ]

  let target (item (current-vertex-index + 1) my-path-vertices)
  let qx item 0 target
  let qy item 1 target

  let d distancexy qx qy
  ifelse d > bus-speed [
    if d > 0 [ set heading towardsxy qx qy ]
    fd bus-speed
  ] [
    setxy qx qy
    set current-vertex-index (current-vertex-index + 1)
  ]

  ;; avería aleatoria (opcional)
  if (not broken-down?) and (random-float 1 < breakdown-probability) [
    set broken-down? true
    set color red
    table:put g-bus-log who (lput (word "Avería@" ticks) (table:get-or-default g-bus-log who []))
  ]
end

to handle-end-of-path  ;; turtle
  ;; Para eliminar saltos al “volver”, por ahora terminamos en IDA:
  table:put g-bus-log who (lput (word "IDA complete - dying (no VUELTA) on line " my-linea "-" my-ramal " at tick " ticks)
                               (table:get-or-default g-bus-log who []))
  die
end

; ============== UTILIDADES VISUALES ==============
to listar-lineas
  let vals map [ f -> gis:property-value f "LINEA" ] (gis:feature-list-of ds)
  show remove-duplicates sort vals
end

to enfocar-linea [linea-str]
  clear-drawing
  gis:set-drawing-color (gray + 1)
  gis:draw ds 0.3
  let feats gis:find-features ds "LINEA" linea-str
  gis:set-drawing-color red
  foreach feats [ f -> gis:draw f 2 ]
end

]]></code>
  <widgets>
    <view x="290" wrappingAllowedX="true" y="40" frameRate="30.0" minPycor="-16" height="1159" showTickCounter="true" patchSize="35.0" fontSize="10" wrappingAllowedY="true" width="1159" tickCounterLabel="ticks" maxPycor="16" updateMode="1" maxPxcor="16" minPxcor="-16"></view>
    <button x="20" y="60" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55" display="Setup">setup</button>
    <slider x="20" step="0.05" y="120" max="2" width="250" display="bus-speed-default" height="50" min="0.2" direction="Horizontal" default="0.6" variable="bus-speed-default"></slider>
    <slider x="20" step="0.0001" y="180" max="0.01" width="250" display="breakdown-probability" height="50" min="0" direction="Horizontal" default="8.0E-4" variable="breakdown-probability"></slider>
    <plot x="20" autoPlotX="true" yMax="10.0" autoPlotY="true" y="255" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="ticks" display="KPIs">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Buses" color="-13345367" legend="true">
        <setup></setup>
        <update>plot count buses</update>
      </pen>
      <pen interval="1.0" mode="0" display="Averiado" color="-2674135" legend="true">
        <setup></setup>
        <update>plot count buses with [ broken-down? ]</update>
      </pen>
    </plot>
    <button x="100" y="60" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55">go</button>
  </widgets>
